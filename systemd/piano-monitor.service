[Unit]
Description=Piano practice monitor
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=heyya
Group=heyya
SupplementaryGroups=audio
WorkingDirectory=/home/heyya/PianoMonitor
ExecStart=/usr/bin/python3 -m monitor.app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=8
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/heyya/PianoMonitor
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
